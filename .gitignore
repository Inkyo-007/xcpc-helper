# ---------- 通用 ----------
.DS_Store
Thumbs.db
*.log

# ---------- 前端 ----------
frontend/node_modules/
frontend/dist/

# ---------- 后端（Python / uv） ----------
backend/.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ---------- 文档 ----------
docs/cache/

# SQLite 检索索引缓存（可随时重建，不入库）
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db-wal
backend/data/*.db-shm

# 导入/导出的上传暂存区（随用随清，不入库）
backend/data/.staging/

# 训练统计：平台凭据（cookie 等敏感数据，仅存本机）
backend/data/user/*/secrets.json

# 训练统计：写操作的原子暂存文件（正常会自动清理，防御崩溃残留）
backend/data/user/**/.tmp-*

# 可视化写操作的原子暂存目录（正常会自动清理，防御崩溃残留）
backend/content/.tmp-*/

# 打印册写操作的原子暂存文件（正常会自动清理，防御崩溃残留）
backend/books/**/.tmp-*

# 免安装压缩包构建输出（scripts/package.ps1）
release/
